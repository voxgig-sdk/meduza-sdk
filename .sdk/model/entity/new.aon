# Entity: new

main: kit: entity: new: {

  alias: field: {}

  fields: [
    {
      name: "description"
      req: false
      short: "Brief description of the article"
      type: "`$STRING`"
    }
    {
      name: "image"
      req: false
      short: "Article image information"
      type: "`$OBJECT`"
    }
    {
      format: "date-time"
      name: "pub_date"
      req: false
      short: "Publication date of the article"
      type: "`$STRING`"
    }
    {
      name: "title"
      req: false
      short: "Title of the article"
      type: "`$STRING`"
    }
    {
      name: "url"
      req: false
      short: "URL of the article"
      type: "`$STRING`"
    }
  ]

  name: "new"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/screens/news"
          segments: [
            {
              lit: "screens"
            }
            {
              lit: "news"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
